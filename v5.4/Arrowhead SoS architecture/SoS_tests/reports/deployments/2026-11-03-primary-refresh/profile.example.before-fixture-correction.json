{
  "test_environment": true,
  "isolated": true,
  "ca": "certs/cloud-ca.pem",
  "timeout_seconds": 15,
  "systems": [
    "ServiceRegistry",
    "Authentication",
    "ConsumerAuthorization"
  ],
  "endpoints": {
    "registry": "https://serviceregistry:8443",
    "authentication": "https://authentication:8444",
    "authorization": "https://consumerauthorization:8445"
  },
  "actors": {
    "inspector": {
      "cert": "certs/inspector.pem",
      "key": "certs/inspector.key",
      "token_env": "SOS_INSPECTOR_TOKEN"
    },
    "provider": {
      "cert": "certs/provider.pem",
      "key": "certs/provider.key",
      "token_env": "SOS_PROVIDER_TOKEN"
    },
    "consumer": {
      "cert": "certs/consumer.pem",
      "key": "certs/consumer.key",
      "token_env": "SOS_CONSUMER_TOKEN"
    },
    "operator": {
      "cert": "certs/operator.pem",
      "key": "certs/operator.key",
      "token_env": "SOS_OPERATOR_TOKEN"
    },
    "loginConsumer": {
      "cert": "certs/consumer.pem",
      "key": "certs/consumer.key"
    }
  },
  "variables": {
    "provider": "SoSTestProvider",
    "consumer": "SoSTestConsumer",
    "otherConsumer": "SoSTestOther"
  },
  "secret_variables": {
    "password": "SOS_CONSUMER_PASSWORD"
  },
  "scenarios": {
    "AUTHZ-no-policy": {
      "setup": [],
      "request": {
        "endpoint": "authorization",
        "actor": "provider",
        "method": "POST",
        "path": "/consumerauthorization/authorization/verify",
        "body": {
          "provider": "${provider}",
          "consumer": "${consumer}",
          "cloud": "LOCAL",
          "targetType": "SERVICE_DEF",
          "target": "sosTestNoPolicy",
          "scope": "read"
        }
      },
      "select": "/body",
      "cleanup": []
    },
    "AUTHZ-all": {
      "setup": [
        {
          "endpoint": "authorization",
          "actor": "operator",
          "method": "POST",
          "path": "/consumerauthorization/authorization/mgmt/grant",
          "body": {
            "list": [
              {
                "provider": "${provider}",
                "cloud": "LOCAL",
                "targetType": "SERVICE_DEF",
                "target": "sosTestAll",
                "defaultPolicy": {
                  "policyType": "ALL"
                },
                "scopedPolicies": {}
              }
            ]
          }
        }
      ],
      "request": {
        "endpoint": "authorization",
        "actor": "provider",
        "method": "POST",
        "path": "/consumerauthorization/authorization/verify",
        "body": {
          "provider": "${provider}",
          "consumer": "${consumer}",
          "cloud": "LOCAL",
          "targetType": "SERVICE_DEF",
          "target": "sosTestAll",
          "scope": "read"
        }
      },
      "select": "/body",
      "cleanup": [
        {
          "endpoint": "authorization",
          "actor": "operator",
          "method": "DELETE",
          "path": "/consumerauthorization/authorization/mgmt/revoke",
          "query": {
            "instanceIds": [
              "MGMT|LOCAL|${provider}|SERVICE_DEF|sosTestAll"
            ]
          }
        }
      ]
    },
